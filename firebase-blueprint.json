        "safetyStatus": { "type": "string", "enum": ["approved", "blocked", "needs_review"], "description": "Safety gate result." },
        "disclosure": { "type": "string", "description": "Mandatory disclosure text." },
        "visibleToUids": { "type": "string", "description": "Authorized reader UIDs." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp." }
      },
      "required": ["familyId", "participantUid", "senderType", "text", "identityMode", "sourceType", "sourceReferences", "requiresHumanInput", "safetyStatus", "disclosure", "visibleToUids", "createdAt"]
    },
    "ConsentRecord": {
      "title": "ConsentRecord",
      "description": "Explicit privacy, voice, and child-onboarding consent record.",
