  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Private user account and notification preferences."
    },
    "/users/{userId}/privateConversations/{conversationId}": {
      "schema": { "$ref": "#/entities/PrivateConversation" },
      "description": "Private-by-default adult companion conversations."
    },
    "/users/{userId}/privateConversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/PrivateMessage" },
      "description": "Messages inside owner-only companion conversations."
    },
    "/families/{familyId}": {
      "schema": { "$ref": "#/entities/FamilyWorkspace" },
      "description": "Isolated family tenant workspaces."
    },
    "/families/{familyId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/FamilyMember" },
      "description": "Family membership, role, and consent records."
    },
