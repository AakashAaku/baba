      "properties": {
        "familyId": { "type": "string", "description": "Family tenant ID." },
        "participantUid": { "type": "string", "description": "Session owner UID." },
        "senderType": { "type": "string", "enum": ["user", "ai"], "description": "User or AI." },
        "text": { "type": "string", "description": "Message content." },
        "identityMode": { "type": "string", "enum": ["DIGITAL_BABA", "BABA_COMPANION", "REAL_BABA"], "description": "Disclosed identity mode." },
