        "version": { "type": "string", "description": "Policy version." },
        "visibleToUids": { "type": "string", "description": "Authorized reader UIDs." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp." }
      },
      "required": ["familyId", "subjectUid", "guardianUid", "purpose", "status", "version", "visibleToUids", "createdAt", "updatedAt"]
    },
    "SafetyEvent": {
      "title": "SafetyEvent",
      "description": "Minimal-metadata safety escalation record (contains no raw private conversation text).",
