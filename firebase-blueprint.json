        "agentMode": { "type": "string", "enum": ["DIGITAL_BABA", "BABA_COMPANION"], "description": "Disclosed AI identity mode." },
        "guardianOversight": { "type": "boolean", "description": "Proportionate adult visibility for child sessions." },
