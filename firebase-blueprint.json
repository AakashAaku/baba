      "properties": {
        "familyId": { "type": "string", "description": "Family tenant ID." },
        "createdBy": { "type": "string", "description": "Creator adult UID." },
        "title": { "type": "string", "description": "Event title." },
        "description": { "type": "string", "description": "Event details." },
        "eventDateLabel": { "type": "string", "description": "Human-readable date/time." },
        "category": { "type": "string", "enum": ["milestone", "birthday", "school", "call", "goal", "family_routine"], "description": "Event category." },
        "childVisible": { "type": "boolean", "description": "Whether children can view this event." },
        "visibleToUids": { "type": "string", "description": "Authorized reader UIDs." },
        "memberUids": { "type": "string", "description": "Denormalized family member UIDs." },
        "adultUids": { "type": "string", "description": "Denormalized adult UIDs." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp." }
      },
      "required": ["familyId", "createdBy", "title", "description", "eventDateLabel", "category", "childVisible", "visibleToUids", "memberUids", "adultUids", "createdAt", "updatedAt"]
    },
